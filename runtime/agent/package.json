{
  "name": "@bohr/agent",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Runs inside each project's container: control server, agent job runner and preview manager.",
  "exports": {
    "./claude-login": "./src/claude-login.ts",
    "./claude-login-routes": "./src/claude-login-routes.ts",
    "./http": "./src/http.ts",
    "./log": "./src/log.ts",
    "./text": "./src/text.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --external:@anthropic-ai/claude-agent-sdk --legal-comments=none --metafile=dist/meta.json --outfile=dist/runner.mjs && node scripts/image-files.mjs dist/meta.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@bohr/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
